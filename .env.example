# Trump Trading Tracker 环境变量配置
# 复制此文件为 .env 并填入你的真实配置

# ============================================
# Telegram Bot (必需 - 用于接收通知)
# ============================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# 如何获取：
# 1. 找 @BotFather 创建 bot，获取 token
# 2. 给 bot 发消息，然后访问:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# 3. 找到 message.chat.id 字段

# ============================================
# OpenAI API (可选 - 用于AI智能分析)
# ============================================
OPENAI_API_KEY=your_openai_api_key_here

# 如果不配置，系统会自动使用免费的关键词匹配模式
# 获取 API Key: https://platform.openai.com/api-keys

# ============================================
# 高级配置 (可选)
# ============================================
# 检查间隔 (分钟)
CHECK_INTERVAL=15

# 最低置信度阈值 (0-100)
MIN_CONFIDENCE=60

# DJT 股价异动阈值 (%)
DJT_ALERT_THRESHOLD=5
